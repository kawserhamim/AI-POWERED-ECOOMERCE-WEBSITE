# ============================================
# Backend environment variables — copy to .env
# ============================================

# Server
PORT=8000
NODE_ENV=development
MONGO_URL=mongodb://localhost:27017/ecommerce_db

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Admin (used by seed script)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345

# CORS — "*" allows any origin, or set to your frontend URL
CORS_ORIGIN=*

# SSLCommerz sandbox credentials
# Sign up at https://developer.sslcommerz.com/registration/
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
IS_LIVE=false
SSL_COMMERZ_CURRENCY=BDT

# IMPORTANT — these URLs MUST be reachable from SSLCommerz's servers,
# not just from your browser. For local development, expose your backend
# via a tunnel (e.g. `ngrok http 8000` or `cloudflared tunnel`) and put
# the public URL here. For production, set them to your real domain.
BACKEND_URL=https://your-tunnel-or-domain.example.com
FRONTEND_URL=http://localhost:5173

# Email (SMTP) — used for transactional mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com

# AI / search keys
GOOGLE_API_KEY=
GROQ_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
